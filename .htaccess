Options -MultiViews
DirectoryIndex index.html
DirectorySlash Off

RewriteEngine On

# The home page has one canonical URL.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[\s?]) [NC]
RewriteRule ^index\.html$ https://%{HTTP_HOST}/ [R=301,L,NE]

RewriteRule ^index/?$ https://%{HTTP_HOST}/ [R=301,L,NE]

# Redirect every public *.html request to its extensionless canonical URL.
# THE_REQUEST prevents a loop after the internal rewrite below.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]) [NC]
RewriteRule ^(.+)\.html$ https://%{HTTP_HOST}/$1 [R=301,L,NE]

# These landing pages share a name with a physical asset/content directory.
# Serve both slash forms during the migration so previously cached Apache
# DirectorySlash redirects cannot trap returning visitors in a redirect loop.
RewriteRule ^(brands|community|products|professionals)/?$ $1.html [L]

# Serve the existing static HTML file for an extensionless request.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
